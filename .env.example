# Copy to .env.local and fill in.

# Postgres connection string. Matches the docker-compose `db` service by default.
# If you set POSTGRES_PASSWORD for Compose (below), use the same password here.
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/asaph

# Compose only — set it in the top-level `.env`, which is what Compose reads (not
# `.env.local`). The `db` service's password, and the one the containerized app
# connects with. Unset, it's the development default in DATABASE_URL above: fine
# on a laptop, not on anything reachable by others. Takes effect only when the
# database volume is first created; see docs/self-hosting.md to change it later.
# Use URL-safe characters, e.g. `openssl rand -hex 32`.
# POSTGRES_PASSWORD=

# Random secret used to sign sessions — generate with `openssl rand -base64 32`
# (or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
BETTER_AUTH_SECRET=

# Where the app is served from. Read at runtime, never compiled in — which is
# what lets one container image run on any origin. Optional: without it Better
# Auth derives the origin per request and the app works, but it warns at every
# boot and the /api/auth/* REST endpoints answer 403 INVALID_ORIGIN (nothing in
# Asaph calls them; the UI is Server Actions). Set it to your public origin.
# Password reset also needs it: the emailed link is built from this, never from
# the request's Host header, which whoever sends the request controls.
BETTER_AUTH_URL=http://localhost:3000

# Set to `false` to close registration — the "Create account" tab disappears from
# /auth and the sign-up API rejects. Anything else (unset, empty, a typo) leaves
# signups open. Create your own account *before* setting this, or a fresh
# deployment has no way in; changing it needs a server restart.
ALLOW_SIGNUPS=true

# Sign-in attempt limits need the client's real address. Behind a reverse proxy
# that appends to X-Forwarded-For, list the proxies' IPs or CIDR ranges here
# (comma-separated). Behind a CDN that sends the client address in its own
# header, name it in CLIENT_IP_HEADER (e.g. cf-connecting-ip). Neither is needed
# for local development. See docs/self-hosting.md#sign-in-attempt-limits.
TRUSTED_PROXIES=
CLIENT_IP_HEADER=

# `true` sends the Content-Security-Policy as report-only (violations are logged
# in the browser console, nothing is blocked). Only for a CDN or proxy that injects
# scripts, while you turn that off. See docs/self-hosting.md.
CSP_REPORT_ONLY=

# Where uploaded item photos are written. Defaults to ./uploads next to the app.
# Point this at a mounted volume in production — the files are not in the image.
UPLOADS_DIR=

# Outgoing mail (SMTP). Optional — leave SMTP_HOST or EMAIL_FROM blank and nothing
# is sent; each message is printed to the server console instead, as before.
# Separate variables rather than one URL so a password full of `/` and `+` needs
# no encoding, and switching providers is a change of values, not of format.
# Port 465 is implicit TLS; any other port must offer STARTTLS, except on
# localhost. See docs/email.md.
#
# Local dev: `docker compose --profile mail up -d mailpit`, then
# SMTP_HOST=localhost, SMTP_PORT=1025, and read mail at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender. Must be an address your provider will send as — on Resend, any
# address on a domain verified in your account. `Asaph <addr>` works.
EMAIL_FROM=

# IGDB (games metadata) — register an app at dev.twitch.tv/console
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# TMDB (movie/TV metadata) — create an account, then take either credential from
# themoviedb.org/settings/api: the 32-char "API Key" or the longer "API Read
# Access Token". Both work and go in this one var. Free for non-commercial use;
# attribute TMDB if this ever becomes public-facing.
TMDB_API_KEY=

# OpenLibrary (book metadata) — no key, just identify the app per their API etiquette
METADATA_USER_AGENT=AsaphJS/0.1 (you@email)
