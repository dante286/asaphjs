node_modules
.next
.git
.gitignore
npm-debug.log*

# env files — pass secrets via --build-arg / compose env, not the build context
.env*

# local-only data — item photos live in ./uploads (UPLOADS_DIR), and the image
# makes its own empty one for the volume to mount over. They used to live under
# public/uploads, which is why this rule pointed there.
uploads

README.md
Dockerfile
.dockerignore
docker-compose.yml

# tests — the builder stage does `COPY . .`, so without these every test-only
# change busts the layer cache and pays for a full `next build` inside Docker.
# Nothing here is imported by the app: the tests are colocated but never
# reachable from a route, and src/test holds their fixtures.
vitest.config.mts
coverage
src/test
**/*.test.ts
