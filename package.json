{
  "name": "asaphjs",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --project=unit --project=providers",
    "test:watch": "vitest --project=unit --project=providers",
    "test:db": "vitest run --project=db",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed/run.ts",
    "lookup:check": "tsx scripts/check-lookup-cache.ts",
    "covers:backfill": "tsx scripts/backfill-covers.ts",
    "email:test": "tsx scripts/email-test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "msw": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
